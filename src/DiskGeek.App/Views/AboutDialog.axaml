<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DiskGeek.App.Views.AboutDialog"
        Title="About DiskGeek"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Navy}"
        Icon="/Assets/diskgeek.ico">

  <!--
    Styled from the shared house tokens (Themes/Dark.axaml) rather than a second hardcoded
    palette. This dialog is the one place a user goes to check what the app is and who made it,
    so going from the navy shell into a near-black dialog was the most visible remaining seam.
  -->
  <Window.Styles>
    <Style Selector="TextBlock.name">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource Txt}" />
    </Style>
    <Style Selector="TextBlock.tag">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource BlueLight}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Txt3}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.kofi">
      <Setter Property="Background" Value="#ff5e5b" />
      <Setter Property="Foreground" Value="#ffffff" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.kofi:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e54e4b" />
      <Setter Property="TextBlock.Foreground" Value="#ffffff" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource Blue}" />
      <Setter Property="Foreground" Value="{StaticResource Txt}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="{StaticResource ButtonBg}" />
      <Setter Property="Foreground" Value="{StaticResource Txt}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.credit">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource Txt3}" />
      <Setter Property="Padding" Value="0,1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.credit:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="{StaticResource BlueLight}" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="28" Spacing="16">

    <StackPanel Orientation="Horizontal" Spacing="16">
      <Image Source="avares://DiskGeek.App/Assets/diskgeek.png" Width="64" Height="64" />
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="name" Text="DiskGeek" />
        <TextBlock Classes="tag" Text="Find out exactly where your disk space went" />
        <TextBlock x:Name="VersionText" Classes="body" Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
            CornerRadius="7" Padding="18">
      <StackPanel Spacing="10">
        <TextBlock Classes="body"
                   Text="Scan any folder or drive, find exact and near-duplicate files quietly eating space, search and batch-rename, compare snapshots over time, and schedule unattended reports." />
        <TextBlock x:Name="LicenceText" Classes="body" />
      </StackPanel>
    </Border>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
            CornerRadius="7" Padding="18">
      <StackPanel Spacing="8">
        <UniformGrid Columns="2">
          <Button x:Name="WebsiteButton" Classes="ghost" Content="Website" Margin="0,0,4,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button x:Name="ProductButton" Classes="ghost" Content="Product page" Margin="4,0,0,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </UniformGrid>
        <UniformGrid Columns="2">
          <Button x:Name="RepoButton" Classes="ghost" Content="Source on GitHub" Margin="0,0,4,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button x:Name="IssuesButton" Classes="ghost" Content="Report a problem" Margin="4,0,0,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </UniformGrid>
        <Button x:Name="DonateButton" Classes="kofi" Content="Support us on Ko-fi"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
            CornerRadius="7" Padding="18">
      <StackPanel Spacing="8">
        <TextBlock Classes="body" Text="More from TechyGeeksHome"
                   FontWeight="SemiBold" Foreground="{StaticResource Txt}" Margin="0,0,0,2" />

        <!--
          One button per app, filled in by BuildFamilyList. Two columns, and the GitHub
          profile button squares the grid off when the number of apps is odd - otherwise it
          drops below as the full-width button instead.
        -->
        <UniformGrid x:Name="FamilyGrid" Columns="2" />

        <Button x:Name="GitHubProfileButton" Classes="accent" Content="All our code on GitHub"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

        <Button x:Name="FamilyHubButton" Classes="credit" Content="See all the free tools"
                HorizontalAlignment="Center" Margin="0,2,0,0" />
      </StackPanel>
    </Border>

    <TextBlock x:Name="UpdateStatusText" Classes="body" Text="" />

    <TextBlock x:Name="CopyrightText" Classes="body" FontSize="11" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CheckUpdatesButton" Classes="ghost" Content="Check for updates" />
      <Button x:Name="CloseButton" Classes="accent" Content="Close" />
    </StackPanel>

  </StackPanel>
</Window>
