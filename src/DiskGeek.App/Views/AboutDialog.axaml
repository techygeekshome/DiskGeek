<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DiskGeek.App.Views.AboutDialog"
        Title="About DiskGeek"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0b0b0d"
        Icon="/Assets/diskgeek.ico">

  <!--
    Deliberately self-contained styling rather than inherited theme colours. This dialog is the
    one place a user goes to check what the app is and who made it, so it has to look like the
    rest of the Geek range even if the host theme changes underneath it. The palette is the same
    one the product pages use: #0b0b0d page, #111113 card, #1f1f22 border, #38bdf8 accent.
  -->
  <Window.Styles>
    <Style Selector="TextBlock.name">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#e5e7eb" />
    </Style>
    <Style Selector="TextBlock.tag">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#38bdf8" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#9ca3af" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.kofi">
      <Setter Property="Background" Value="#ff5e5b" />
      <Setter Property="Foreground" Value="#ffffff" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.kofi:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e54e4b" />
      <Setter Property="TextBlock.Foreground" Value="#ffffff" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#38bdf8" />
      <Setter Property="Foreground" Value="#0b0b0d" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#1a1a1e" />
      <Setter Property="Foreground" Value="#e5e7eb" />
      <Setter Property="BorderBrush" Value="#1f1f22" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.credit">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#9ca3af" />
      <Setter Property="Padding" Value="0,1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.credit:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#38bdf8" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="28" Spacing="16">

    <StackPanel Orientation="Horizontal" Spacing="16">
      <Image Source="avares://DiskGeek.App/Assets/diskgeek.png" Width="64" Height="64" />
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="name" Text="DiskGeek" />
        <TextBlock Classes="tag" Text="Find out exactly where your disk space went" />
        <TextBlock x:Name="VersionText" Classes="body" Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>

    <Border Background="#111113" BorderBrush="#1f1f22" BorderThickness="1"
            CornerRadius="16" Padding="18">
      <StackPanel Spacing="10">
        <TextBlock Classes="body"
                   Text="Scan any folder or drive, find exact and near-duplicate files quietly eating space, search and batch-rename, compare snapshots over time, and schedule unattended reports." />
        <TextBlock x:Name="LicenceText" Classes="body" />
      </StackPanel>
    </Border>

    <Border Background="#111113" BorderBrush="#1f1f22" BorderThickness="1"
            CornerRadius="16" Padding="18">
      <StackPanel Spacing="8">
        <UniformGrid Columns="2">
          <Button x:Name="WebsiteButton" Classes="ghost" Content="Website" Margin="0,0,4,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button x:Name="ProductButton" Classes="ghost" Content="Product page" Margin="4,0,0,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </UniformGrid>
        <UniformGrid Columns="2">
          <Button x:Name="RepoButton" Classes="ghost" Content="Source on GitHub" Margin="0,0,4,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button x:Name="IssuesButton" Classes="ghost" Content="Report a problem" Margin="4,0,0,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </UniformGrid>
        <Button x:Name="DonateButton" Classes="kofi" Content="Support us on Ko-fi"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>

    <Border Background="#111113" BorderBrush="#1f1f22" BorderThickness="1"
            CornerRadius="16" Padding="18">
      <StackPanel Spacing="8">
        <TextBlock Classes="body" Text="More from TechyGeeksHome"
                   FontWeight="SemiBold" Foreground="#e5e7eb" Margin="0,0,0,2" />

        <!--
          One button per app, filled in by BuildFamilyList. Two columns, and the GitHub
          profile button squares the grid off when the number of apps is odd - otherwise it
          drops below as the full-width button instead.
        -->
        <UniformGrid x:Name="FamilyGrid" Columns="2" />

        <Button x:Name="GitHubProfileButton" Classes="accent" Content="All our code on GitHub"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

        <Button x:Name="FamilyHubButton" Classes="credit" Content="See all the free tools"
                HorizontalAlignment="Center" Margin="0,2,0,0" />
      </StackPanel>
    </Border>

    <TextBlock x:Name="UpdateStatusText" Classes="body" Text="" />

    <TextBlock x:Name="CopyrightText" Classes="body" FontSize="11" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CheckUpdatesButton" Classes="ghost" Content="Check for updates" />
      <Button x:Name="CloseButton" Classes="accent" Content="Close" />
    </StackPanel>

  </StackPanel>
</Window>
