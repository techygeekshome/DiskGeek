<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DiskGeek.App.ViewModels"
        xmlns:conv="using:DiskGeek.App.Converters"
        xmlns:controls="using:DiskGeek.App.Controls"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="DiskGeek.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/diskgeek.ico"
        Width="1080" Height="680">

    <Window.Resources>
        <conv:PercentToWidthConverter x:Key="PercentToWidth" MaxWidth="60" />
        <conv:PercentToWidthConverter x:Key="PercentToWidthWide" MaxWidth="140" />
    </Window.Resources>

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemBaseLowColor}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBox Grid.Column="0" Text="{Binding FolderPath}" Watermark="Folder to scan…" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="Browse…" Click="OnBrowseClicked" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="Scan" Command="{Binding ScanCommand}" Classes="accent" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsScanning}" Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="Permissions…" Click="OnPermissionsClicked" IsEnabled="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,8,0" />
                <Button Grid.Column="5" Content="Export ▾" IsEnabled="{Binding CanExport}" Margin="0,0,8,0">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Export to CSV…" Click="OnExportCsvClicked" />
                            <MenuItem Header="Export to HTML report…" Click="OnExportHtmlClicked" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="6" Content="Check for Updates…" Command="{Binding Updates.CheckNowCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="7" Content="About…" Click="OnAboutClicked" />
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="10,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemBaseLowColor}">
            <Grid ColumnDefinitions="*,Auto,120">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ElapsedDisplay}" IsVisible="{Binding IsScanning}" Margin="8,0" VerticalAlignment="Center" Foreground="Gray" />
                <ProgressBar Grid.Column="2" IsIndeterminate="{Binding IsScanning}" IsVisible="{Binding IsScanning}" Height="6" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Body: tree on the left, detail table on the right, with a hard-to-miss scanning banner
             overlaid on top while a scan is running (this used to be easy to mistake for a hang on
             a big drive — the status bar update alone wasn't prominent enough). -->
        <Panel>
            <Grid ColumnDefinitions="320,4,*">
                <TreeView Grid.Column="0" ItemsSource="{Binding RootNodes}" SelectedItem="{Binding SelectedNode}" Margin="4">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate DataType="vm:FileSystemNodeViewModel" ItemsSource="{Binding Children}">
                            <Grid ColumnDefinitions="20,*,Auto,60" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullPath}" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Margin="6,0" Foreground="Gray" FontSize="11" />
                                <Border Grid.Column="3" Height="6" CornerRadius="3" Background="{DynamicResource SystemBaseLowColor}" VerticalAlignment="Center">
                                    <Border HorizontalAlignment="Left" Height="6" CornerRadius="3" Background="#1a73e8"
                                            Width="{Binding PercentOfRoot, Converter={StaticResource PercentToWidth}}" />
                                </Border>
                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Grid.Column="1" Background="{DynamicResource SystemBaseLowColor}" />

                <TabControl Grid.Column="2" Margin="4">
                    <TabItem Header="List">
                        <DataGrid ItemsSource="{Binding DetailItems}"
                                  IsReadOnly="True" GridLinesVisibility="Horizontal" AutoGenerateColumns="False"
                                  CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Name" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="vm:FileSystemNodeViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Icon}" />
                                                <TextBlock Text="{Binding Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="100" />
                                <DataGridTemplateColumn Header="% of Total" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="vm:FileSystemNodeViewModel">
                                            <Border Height="10" CornerRadius="3" Background="{DynamicResource SystemBaseLowColor}" VerticalAlignment="Center" Margin="4,0">
                                                <Border HorizontalAlignment="Left" Height="10" CornerRadius="3" Background="#1a73e8"
                                                        Width="{Binding PercentOfRoot, Converter={StaticResource PercentToWidthWide}}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="80" />
                                <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedDisplay}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Treemap">
                        <controls:TreemapView x:Name="Treemap" ItemsSource="{Binding DetailItems}" NodeClicked="OnTreemapNodeClicked" />
                    </TabItem>
                    <TabItem Header="Duplicates">
                        <TabControl x:Name="DuplicatesModeTabs">
                            <TabItem Header="Exact Duplicates">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Padding="10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemBaseLowColor}">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                            <Button Grid.Column="0" Content="Find Duplicates" Command="{Binding FindDuplicatesCommand}" Classes="accent" Margin="0,0,8,0" />
                                            <Button Grid.Column="1" Content="Cancel" Command="{Binding Duplicates.CancelCommand}" IsEnabled="{Binding Duplicates.IsScanning}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Duplicates.StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Grid.Column="3" IsIndeterminate="True" IsVisible="{Binding Duplicates.IsScanning}" Width="100" Height="6" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border DockPanel.Dock="Bottom" Padding="10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemBaseLowColor}" IsVisible="{Binding Duplicates.HasResults}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                                <Run Text="Selected: " />
                                                <Run Text="{Binding Duplicates.SelectedBytesDisplay}" FontWeight="Bold" />
                                                <Run Text=" — the oldest copy in each group is unchecked by default; review before deleting." Foreground="Gray" />
                                            </TextBlock>
                                            <Button Grid.Column="1" Content="Delete Selected…" Click="OnDeleteSelectedDuplicatesClicked"
                                                    IsEnabled="{Binding Duplicates.HasSelection}" Background="#d93025" Foreground="White" />
                                        </Grid>
                                    </Border>

                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding Duplicates.Groups}" Margin="8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:DuplicateGroupViewModel">
                                                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="6" Background="{DynamicResource SystemAltMediumLowColor}">
                                                        <StackPanel Spacing="6">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" FontWeight="Bold">
                                                                    <Run Text="{Binding CopyCount}" /><Run Text=" copies · " /><Run Text="{Binding SizeDisplay}" /><Run Text=" each" />
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1" Foreground="#d93025" FontWeight="Bold">
                                                                    <Run Text="{Binding WastedDisplay}" /><Run Text=" wasted" />
                                                                </TextBlock>
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Files}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="vm:DuplicateFileEntryViewModel">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2">
                                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding FullPath}" TextTrimming="CharacterEllipsis"
                                                                                       Margin="4,0" VerticalAlignment="Center" ToolTip.Tip="{Binding FullPath}" />
                                                                            <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Foreground="Gray" Margin="6,0" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="3" Text="{Binding ModifiedDisplay}" Foreground="Gray" VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Similar Images">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Padding="10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemBaseLowColor}">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                <Button Grid.Column="0" Content="Find Similar Images" Command="{Binding FindSimilarImagesCommand}" Classes="accent" Margin="0,0,8,0" />
                                                <Button Grid.Column="1" Content="Cancel" Command="{Binding SimilarImages.CancelCommand}" IsEnabled="{Binding SimilarImages.IsScanning}" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding SimilarImages.StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Grid.Column="3" IsIndeterminate="True" IsVisible="{Binding SimilarImages.IsScanning}" Width="100" Height="6" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Similarity sensitivity:" VerticalAlignment="Center" Foreground="Gray" />
                                                <Slider Minimum="0" Maximum="20" Value="{Binding SimilarImages.Sensitivity}" Width="160" VerticalAlignment="Center" IsEnabled="{Binding !SimilarImages.IsScanning}" />
                                                <TextBlock Text="{Binding SimilarImages.Sensitivity}" VerticalAlignment="Center" Width="20" />
                                                <TextBlock Text="(0 = only near-exact re-saves, higher = looser matching)" Foreground="Gray" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border DockPanel.Dock="Bottom" Padding="10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemBaseLowColor}" IsVisible="{Binding SimilarImages.HasResults}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                                <Run Text="Selected: " />
                                                <Run Text="{Binding SimilarImages.SelectedBytesDisplay}" FontWeight="Bold" />
                                                <Run Text=" — the largest (likely best-quality) copy in each group is unchecked by default; review before deleting." Foreground="Gray" />
                                            </TextBlock>
                                            <Button Grid.Column="1" Content="Delete Selected…" Click="OnDeleteSelectedSimilarImagesClicked"
                                                    IsEnabled="{Binding SimilarImages.HasSelection}" Background="#d93025" Foreground="White" />
                                        </Grid>
                                    </Border>

                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding SimilarImages.Groups}" Margin="8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:SimilarImageGroupViewModel">
                                                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="6" Background="{DynamicResource SystemAltMediumLowColor}">
                                                        <StackPanel Spacing="6">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" FontWeight="Bold">
                                                                    <Run Text="{Binding CopyCount}" /><Run Text=" similar-looking images" />
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1" Foreground="#d93025" FontWeight="Bold">
                                                                    <Run Text="{Binding WastedDisplay}" /><Run Text=" wasted" />
                                                                </TextBlock>
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Files}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="vm:DuplicateFileEntryViewModel">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2">
                                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding FullPath}" TextTrimming="CharacterEllipsis"
                                                                                       Margin="4,0" VerticalAlignment="Center" ToolTip.Tip="{Binding FullPath}" />
                                                                            <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Foreground="Gray" Margin="6,0" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="3" Text="{Binding ModifiedDisplay}" Foreground="Gray" VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </TabItem>
                    <TabItem Header="Search">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemBaseLowColor}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto,140">
                                        <TextBox Grid.Column="0" Text="{Binding Search.NamePattern}" Watermark="Name pattern, e.g. *.log or report*" Margin="0,0,8,0" />
                                        <CheckBox Grid.Column="1" Content="Regex" IsChecked="{Binding Search.UseRegex}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="2" Text="{Binding Search.Extensions}" Watermark="Extensions: jpg,png" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,100,Auto,100,Auto,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="Size (MB):" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="1" Text="{Binding Search.MinSizeMb}" Watermark="min" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="2" Text="to" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="3" Text="{Binding Search.MaxSizeMb}" Watermark="max" Margin="0,0,16,0" />
                                        <CheckBox Grid.Column="4" Content="Files" IsChecked="{Binding Search.IncludeFiles}" Margin="0,0,12,0" />
                                        <CheckBox Grid.Column="5" Content="Folders" IsChecked="{Binding Search.IncludeDirectories}" Margin="0,0,12,0" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,140,Auto,140,*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="Modified:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <DatePicker Grid.Column="1" SelectedDate="{Binding Search.ModifiedAfter}" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="2" Text="to" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <DatePicker Grid.Column="3" SelectedDate="{Binding Search.ModifiedBefore}" Margin="0,0,16,0" />
                                        <Button Grid.Column="5" Content="Clear" Command="{Binding Search.ClearCommand}" Margin="0,0,8,0" />
                                        <Button Grid.Column="6" Content="Search" Command="{Binding Search.RunCommand}" Classes="accent" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Search.StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding Search.IsSearching}" Width="100" Height="6" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border DockPanel.Dock="Bottom" Padding="10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemBaseLowColor}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Select rows (Ctrl/Shift-click for multiple), then batch-rename them." Foreground="Gray" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Batch Rename Selected…" Click="OnBatchRenameSelectedClicked" x:Name="BatchRenameButton" />
                                </Grid>
                            </Border>

                            <DataGrid x:Name="SearchResultsGrid" ItemsSource="{Binding Search.Results}" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                      AutoGenerateColumns="False" CanUserSortColumns="True" SelectionMode="Extended" DoubleTapped="OnSearchResultDoubleTapped">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Name" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="vm:SearchResultViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Icon}" />
                                                    <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding FullPath}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Full Path" Binding="{Binding FullPath}" Width="2*" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="100" />
                                    <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="70" />
                                    <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedDisplay}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Snapshots">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemBaseLowColor}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                                        <Button Grid.Column="0" Content="Save Snapshot…" Click="OnSaveSnapshotClicked" IsEnabled="{Binding Snapshots.CanSaveSnapshot}" Margin="0,0,8,0" />
                                        <Button Grid.Column="1" Content="Load Baseline…" Click="OnLoadBaselineClicked" Margin="0,0,8,0" />
                                        <Button Grid.Column="2" Content="Compare" Click="OnCompareSnapshotClicked" IsEnabled="{Binding Snapshots.CanCompare}" Classes="accent" Margin="0,0,8,0" />
                                    </Grid>
                                    <TextBlock Text="{Binding Snapshots.BaselineLabel}" Foreground="Gray" FontSize="11" IsVisible="{Binding Snapshots.BaselineLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{Binding Snapshots.StatusText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Grid IsVisible="{Binding Snapshots.HasComparison}" ColumnDefinitions="*,*,*,*" Margin="8">
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Added" FontWeight="Bold" Foreground="#1a7f37" Margin="0,0,0,4" />
                                    <ScrollViewer MaxHeight="400">
                                        <ItemsControl ItemsSource="{Binding Snapshots.Added}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:SnapshotChangeViewModel">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" Margin="0,0,4,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullPath}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Foreground="Gray" FontSize="11" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0">
                                    <TextBlock Text="Removed" FontWeight="Bold" Foreground="#d93025" Margin="0,0,0,4" />
                                    <ScrollViewer MaxHeight="400">
                                        <ItemsControl ItemsSource="{Binding Snapshots.Removed}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:SnapshotChangeViewModel">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" Margin="0,0,4,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullPath}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Foreground="Gray" FontSize="11" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0">
                                    <TextBlock Margin="0,0,0,4">
                                        <Run Text="Changed" FontWeight="Bold" />
                                        <Run Text=" (net " /><Run Text="{Binding Snapshots.NetChangeDisplay}" FontWeight="Bold" /><Run Text=")" />
                                    </TextBlock>
                                    <ScrollViewer MaxHeight="400">
                                        <ItemsControl ItemsSource="{Binding Snapshots.Changed}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:SnapshotChangeViewModel">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" Margin="0,0,4,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullPath}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding DeltaDisplay}" Foreground="Gray" FontSize="11" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="4,0,0,0">
                                    <TextBlock Text="Moved / Renamed" FontWeight="Bold" Foreground="#8a6d00" Margin="0,0,0,4" />
                                    <ScrollViewer MaxHeight="400">
                                        <ItemsControl ItemsSource="{Binding Snapshots.Moved}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:SnapshotMoveViewModel">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2" ToolTip.Tip="{Binding PathTooltip}">
                                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" Margin="0,0,4,0" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding NameDisplay}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding KindDisplay}" Foreground="Gray" FontSize="10" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Foreground="Gray" FontSize="11" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- All floating banners stack together at the top of the content area rather than each
                 being independently positioned - a tab's own bottom-docked content (e.g. the
                 Duplicates/Similar Images "Delete Selected" bar) lives in this same body region, so
                 anchoring a banner to the bottom risked overlapping it. Stacking vertically here
                 means each visible banner claims its own space and nothing overlaps, regardless of
                 which combination happens to be showing at once. -->
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16" Spacing="8">

                <!-- Scanning banner: unmissable, with its own Cancel button so the user never has to
                     wonder whether anything is happening. -->
                <Border IsVisible="{Binding IsScanning}"
                        Background="#1a73e8" CornerRadius="8" Padding="16,12"
                        BoxShadow="0 4 16 0 #40000000">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="White" FontWeight="Bold" FontSize="14"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ElapsedDisplay}" Foreground="#dbe6ff" Margin="12,0" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" />
                        </Grid>
                        <ProgressBar IsIndeterminate="True" Height="4" />
                    </StackPanel>
                </Border>

                <!-- Update-available banner: stays up until explicitly dismissed or the download
                     link is followed - unlike the scanning banner, this isn't tied to a transient
                     in-progress operation, so it shouldn't disappear on its own. -->
                <Border IsVisible="{Binding Updates.UpdateAvailable}"
                        Background="#1a7f37" CornerRadius="8" Padding="16,12"
                        BoxShadow="0 4 16 0 #40000000">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontWeight="Bold" Foreground="White" FontSize="14">
                                <Run Text="A new version is available" />
                                <Run Text=" (" /><Run Text="{Binding Updates.LatestVersionDisplay}" /><Run Text=")" />
                            </TextBlock>
                            <TextBlock Text="{Binding Updates.AboutText}" Foreground="#dcf0e3" FontSize="12"
                                       TextTrimming="CharacterEllipsis" IsVisible="{Binding Updates.AboutText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Download" Click="OnDownloadUpdateClicked" Margin="12,0,8,0" Classes="accent" />
                        <Button Grid.Column="2" Content="Dismiss" Command="{Binding Updates.DismissCommand}" />
                    </Grid>
                </Border>

                <!-- Result of an explicit "Check for Updates" click when nothing was found (either
                     already up to date, or the check itself failed) - the silent startup check never
                     shows this, since "no update / couldn't check" isn't worth interrupting anyone
                     for unless they specifically asked. -->
                <Border IsVisible="{Binding Updates.ShowStatusMessage}"
                        Background="#3a3f4b" CornerRadius="8" Padding="16,12"
                        BoxShadow="0 4 16 0 #40000000">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Updates.StatusText}" Foreground="White" FontSize="13"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Dismiss" Command="{Binding Updates.DismissStatusMessageCommand}" Margin="12,0,0,0" />
                    </Grid>
                </Border>
            </StackPanel>
        </Panel>
    </DockPanel>
</Window>
