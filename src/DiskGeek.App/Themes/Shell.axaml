<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Application.Styles is built before Application.Resources, so a StaticResource lookup in
    here cannot see the app-level dictionary. Merge the palette in locally as well; it is the
    same file, so there is still exactly one definition of every token.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DiskGeek.App/Themes/Dark.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!--
    The shell's control styles, matching DriverGeek/CleanGeek/AppGeek. Kept in one file rather
    than repeated per view, so a change to a nav item or a card lands everywhere at once.
  -->

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Txt}" />
  </Style>

  <!-- Sidebar navigation -->
  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="Foreground" Value="{StaticResource Txt2}" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PanelHover}" />
  </Style>
  <Style Selector="Button.nav.on /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Selected}" />
  </Style>
  <Style Selector="Button.nav.on">
    <Setter Property="Foreground" Value="{StaticResource Txt}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Section label above a nav group -->
  <Style Selector="TextBlock.navsection">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Txt4}" />
    <Setter Property="Margin" Value="10,4,10,6" />
  </Style>

  <!-- Secondary button -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Foreground" Value="{StaticResource Txt2}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PanelHover}" />
  </Style>

  <!-- A ghost button that sits in a header row rather than the sidebar: no stretch. -->
  <Style Selector="Button.toolbtn">
    <Setter Property="Background" Value="{StaticResource ButtonBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Foreground" Value="{StaticResource Txt2}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.toolbtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PanelHover}" />
  </Style>

  <!-- The one primary action per screen -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Blue}" />
    <Setter Property="Foreground" Value="{StaticResource Txt}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="15,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BlueHover}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ButtonBg}" />
    <Setter Property="TextBlock.Foreground" Value="{StaticResource Txt4}" />
  </Style>

  <!-- Page title and its one status line -->
  <Style Selector="TextBlock.pagetitle">
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.status">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Txt3}" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Border.cardhead">
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="17,13" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="BorderBrush" Value="{StaticResource LineSoft}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="17,14" />
  </Style>
  <Style Selector="Border.band">
    <Setter Property="Background" Value="{StaticResource Panel2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <Style Selector="TextBlock.sub">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Txt3}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.meta">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource Txt3}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Txt2}" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource ControlBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Foreground" Value="{StaticResource Txt}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{StaticResource ControlBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Foreground" Value="{StaticResource Txt}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <!-- Default button, for anything not explicitly classed -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource ButtonBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Foreground" Value="{StaticResource Txt2}" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PanelHover}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Txt2}" />
  </Style>

  <!-- The DataGrid on Search needs explicit colours or it renders on Fluent's light defaults. -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineSoft}" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Txt2}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <!-- Fluent's default cell padding is generous enough that a numeric column has to be ~30px
       wider than its content just to avoid clipping. Tighten it once, here. -->
  <Style Selector="DataGridCell">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="Foreground" Value="{StaticResource Txt3}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="8,10" />
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{StaticResource PanelHover}" />
  </Style>

  <Style Selector="TreeView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Txt2}" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="Foreground" Value="{StaticResource Txt2}" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

</Styles>
